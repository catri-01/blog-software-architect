---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 2rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: var(--color-primary);
				/* Style Medium.com : Police plus grande, Serif, aéré */
				font-family: var(--font-serif);
				font-size: 1.25rem; /* ~20px */
				line-height: 1.8;
				font-weight: 400;
			}

			/* Styles pour le contenu Markdown (injecté via slot) */
			.prose :global(p) {
				margin-bottom: 2rem;
				color: rgba(41, 41, 41, 1); /* Gris très foncé doux pour la lecture */
			}

			.prose :global(h1), 
			.prose :global(h2), 
			.prose :global(h3), 
			.prose :global(h4) {
				font-family: 'Inter', sans-serif; /* Sans-serif pour structurer le contenu */
				font-weight: 800;
				color: #1a1a1a;
				margin-top: 3.5rem;
				margin-bottom: 1rem;
				line-height: 1.2;
				letter-spacing: -0.02em;
			}

			.prose :global(h2) { font-size: 2rem; }
			.prose :global(h3) { font-size: 1.6rem; }
			.prose :global(h4) { font-size: 1.3rem; }

			.prose :global(ul), .prose :global(ol) {
				margin-bottom: 2rem;
				padding-left: 1.5rem;
			}
			
			.prose :global(ul) { list-style-type: disc; }
			.prose :global(ol) { list-style-type: decimal; }

			.prose :global(li) {
				margin-bottom: 0.75rem;
			}

			/* Style automatique pour toutes les images dans le corps des articles */
			.prose :global(img) {
				margin-top: 3rem;
				margin-bottom: 3rem;
				border-radius: 0.5rem;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
			}

			.prose :global(blockquote) {
				border-left: 3px solid var(--color-terra);
				padding-left: 1.5rem;
				margin: 2.5rem 0 2.5rem -1.5rem;
				font-style: italic;
				font-size: 1.4rem;
				color: #555;
			}

			/* Titre principal de l'article */
			.title h1 {
				margin: 0 0 0.5em 0;
				font-family: var(--font-serif);
				font-size: 3rem; /* Titre principal plus imposant */
				line-height: 1.1;
				color: var(--color-primary);
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--color-sage);
				font-weight: 600;
			}
			/* Style du bouton retour */
			.back-link {
				display: inline-block;
				margin-top: 2rem;
				margin-bottom: 2rem;
				color: #e67e5f; /* Ta couleur Terra directe */
				text-decoration: none;
				font-family: serif;
				font-style: italic;
				font-weight: 600;
				transition: transform 0.2s ease;
			}
			.back-link:hover {
				transform: translateX(-8px);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}

				<div class="prose">
					<a href="/blog" class="back-link">
						← Back to blog
					</a>

					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />

					<div style="border-top: 1px solid #eee; margin-top: 4rem;">
						<a href="/blog" class="back-link">
							← Back to blog
						</a>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
